    "@react-navigation/stack": "^7.2.10",
    "@rnmapbox/maps": "^10.1.38",
    "deprecated-react-native-prop-types": "^5.0.0",
    "lottie-react-native": "^7.2.2",
    "react": "19.0.0",
    "react-hook-form": "^7.56.0",
    "react-native": "0.79.1",
