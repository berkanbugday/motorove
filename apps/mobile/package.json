{
  "name": "@motorove/mobile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --fix",
    "dev": "react-native start",
    "test": "jest",
    "pod-install": "cd ios && pod install",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace motorove.xcworkspace -scheme motorove -configuration Debug"
  },
  "dependencies": {
    "@react-native-community/geolocation": "3.4.0",
    "@react-navigation/bottom-tabs": "7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@rnmapbox/maps": "10.1.38",
    "@tanstack/react-query": "^5.72.2",
    "@turf/turf": "7.2.0",
    "axios": "^1.8.4",
    "react": "19.1.0",
    "react-native": "0.79.1",
    "react-native-camera": "4.2.1",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "2.25.0",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-reanimated": "3.17.3",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.10.0",
    "react-native-ui-lib": "7.39.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-view-shot": "4.0.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/runtime": "^7.27.0",
    "@motorove/config": "workspace:*",
    "@react-native-community/cli": "18.0.0",
    "@react-native/babel-preset": "0.79.1",
    "@react-native/metro-config": "0.79.1",
    "@react-native/typescript-config": "0.79.1",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "react-native-cli": "2.0.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "jest": {
    "config": "@motorove/config/jest/mobile"
  }
}