{
  "name": "@motorove/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "dev": "react-native start",
    "test": "jest",
    "pod-install": "cd ios && pod install",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace MobileApp.xcworkspace -scheme MobileApp -configuration Release"
  },
  "dependencies": {
    "@react-native-community/geolocation": "3.4.0",
    "@react-navigation/bottom-tabs": "7.2.1",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/native-stack": "^7.2.1",
    "@rnmapbox/maps": "10.1.37",
    "@tanstack/react-query": "^5.24.1",
    "axios": "^1.6.7",
    "react": "18.2.0",
    "react-native": "0.73.5",
    "react-native-gesture-handler": "2.24.0",
    "react-native-modal": "14.0.0-rc.0",
    "react-native-reanimated": "3.6.1",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "^4.9.1",
    "react-native-ui-lib": "7.38.1",
    "react-native-vector-icons": "^10.2.0",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.26.9",
    "@motorove/config": "workspace:*",
    "@react-native-community/cli": "17.0.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "react-native-cli": "2.0.1",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.5.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "jest": {
    "config": "@motorove/config/jest/mobile"
  }
}