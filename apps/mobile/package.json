{
  "name": "motorove",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android:dev": "ENVFILE=.env.dev react-native run-android",
    "android:staging": "ENVFILE=.env.staging react-native run-android",
    "android:prod": "ENVFILE=.env.prod react-native run-android",
    "ios:dev": "ENVFILE=.env.dev react-native run-ios",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint --config eslint.config.cjs .",
    "start": "react-native start",
    "test": "jest",
    "run-both": "concurrently \"pnpm android\" \"pnpm ios\"",
    "postinstall": "patch-package",
    "clear-cache": "node scripts/clear-metro-cache.js",
    "start:clean": "pnpm clear-cache && RESET_CACHE=true react-native start"
  },
