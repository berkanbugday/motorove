{
  "name": "@motorove/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android:dev": "ENVFILE=.env.dev react-native run-android --mode=devDebug --appId com.motorove.dev",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appId com.motorove.staging",
    "android:prod": "ENVFILE=.env react-native run-android --mode=prodDebug",
    "android:release:dev": "ENVFILE=.env.dev react-native run-android --mode=devRelease --appId com.motorove.dev",
    "android:release:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingRelease --appId com.motorove.staging",
    "android:release:prod": "ENVFILE=.env react-native run-android --mode=prodRelease",
    "build:android:dev": "cd android && ENVFILE=.env.dev ./gradlew assembleDevDebug",
    "build:android:staging": "cd android && ENVFILE=.env.staging ./gradlew assembleStagingRelease",
    "build:android:prod": "cd android && ENVFILE=.env ./gradlew assembleProdRelease",
    "ios:dev": "ENVFILE=.env.dev react-native run-ios --scheme 'motoroveDev' --simulator='iPhone 14'",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme 'motoroveStaging'",
    "ios:prod": "ENVFILE=.env react-native run-ios --scheme 'motorove'",
    "build:ios:dev": "ENVFILE=.env.dev react-native run-ios --scheme 'motoroveDev'",
    "build:ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme 'motoroveStaging'",
    "build:ios:prod": "ENVFILE=.env react-native run-ios --scheme 'motorove'",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint --config eslint.config.cjs .",
    "dev": "react-native start",
    "test": "jest",
    "run-both": "concurrently \"pnpm android:dev\" \"pnpm ios:dev\"",
    "clear-cache": "node scripts/clear-metro-cache.js",
    "start:clean": "pnpm clear-cache && RESET_CACHE=true react-native start",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@hookform/resolvers": "5.0.1",
    "@motorove/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "22.2.0",
    "@react-native-firebase/in-app-messaging": "22.2.0",
    "@react-native-firebase/messaging": "22.2.0",
    "@react-navigation/bottom-tabs": "7.3.10",
    "@react-navigation/native": "7.1.6",
    "@react-navigation/native-stack": "7.3.10",
    "@react-navigation/stack": "7.2.10",
    "@sentry/react-native": "6.13.0",
    "deprecated-react-native-prop-types": "5.0.0",
    "graphql": "16.11.0",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-hook-form": "7.56.0",
    "react-native": "0.79.1",
    "react-native-config": "1.5.5",
    "react-native-date-picker": "5.0.12",
    "react-native-encrypted-storage": "4.0.3",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "2.25.0",
    "react-native-image-picker": "8.2.0",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-maps": "1.23.8",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.10.0",
    "react-native-snap-carousel": "3.9.1",
    "react-native-svg": "15.11.2",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@eslint/eslintrc": "3.3.1",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.1",
    "@react-native/eslint-config": "0.79.1",
    "@react-native/metro-config": "0.79.1",
    "@react-native/typescript-config": "0.79.1",
    "@types/jest": "29.5.13",
    "@types/react": "19.0.0",
    "@types/react-native-snap-carousel": "3.8.11",
    "@types/react-test-renderer": "19.0.0",
    "babel-plugin-module-resolver": "5.0.2",
    "concurrently": "9.1.2",
    "eslint": "9.25.0",
    "jest": "29.6.3",
    "metro-cache": "0.82.1",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "1.5.0",
    "react-test-renderer": "19.0.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.6.0"
  },
  "packageManager": "pnpm@9.6.0"
}
