fastlane_version "2.219.0"

# Import helper files
import "./helpers/Fastlane.helper"

# Environment handling
before_all do |lane, options|
  # Use appropriate .env file by default
  env = options[:env] || "dev"
  env_file = env == "prod" ? ".env" : ".env.#{env}"
  UI.message("Loading environment from #{env_file}")
  Dotenv.load(env_file)
end

# Error handling for all lanes
error do |lane, exception|
  # Error reporting logic
  UI.error("Lane #{lane} failed with: #{exception}")
  # Notify your team here (Slack, Email, etc)
end

#####################
# PLATFORM: iOS
#####################
platform :ios do
  desc "Build the iOS application for specified environment"
  lane :build do |options|
    # Load environment-specific configuration
    env = options[:env] || "dev"
    prepare_build(platform: "ios", env: env)
    
    # Determine the correct .env file for this environment
    env_file = env == "prod" ? ".env" : ".env.#{env}"
    
    # Set ENVFILE environment variable for react-native-config
    # This ensures react-native-config reads from the correct .env file
    ENV["ENVFILE"] = env_file
    UI.message("Setting ENVFILE=#{env_file} for react-native-config")
    
    # Setup code signing
    match(
      type: get_match_type(env: env),
      app_identifier: ENV["IOS_APP_IDENTIFIER"],
      readonly: true,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"],
      api_key_path: nil  # Don't use API key for match, only for TestFlight upload
    )
    
    # Build iOS app with ENVFILE environment variable set
    # This is critical for react-native-config to load the correct .env file
    # Use absolute path to ensure the .env file is found correctly
    absolute_env_path = File.expand_path("../#{env_file}", __dir__)
    UI.message("Using absolute ENVFILE path: #{absolute_env_path}")
    
    # Create a safe filename by replacing spaces with underscores
    safe_app_name = ENV['APP_NAME'].downcase.gsub(' ', '-')
    
    gym(
      scheme: ENV["IOS_SCHEME"],
      workspace: ENV["IOS_WORKSPACE"],
      configuration: ENV["IOS_CONFIGURATION"],
      export_method: ENV["IOS_EXPORT_METHOD"],
      output_directory: "build/ios/#{env}",
      output_name: "#{safe_app_name}.ipa",
      clean: true,
      xcargs: "ENVFILE=#{absolute_env_path}"
    )
  end
  
  desc "Release to App Store Connect"
  lane :release_appstore do |options|
    env = options[:env] || "prod"
    build(env: env)
    
    safe_app_name = ENV['APP_NAME'].downcase.gsub(' ', '-')
    deliver(
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      ipa: "build/ios/#{env}/#{safe_app_name}.ipa"
    )
  end
  
  desc "Deploy a beta build to TestFlight"
  lane :deploy_testflight do |options|
    env = options[:env] || "staging"
    build(env: env)
    
    safe_app_name = ENV['APP_NAME'].downcase.gsub(' ', '-')
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "build/ios/#{env}/#{safe_app_name}.ipa",
      username: ENV["FASTLANE_USER"],
      app_identifier: ENV["IOS_APP_IDENTIFIER"],
      apple_id: ENV["FASTLANE_APPLE_ID"]
    )
  end
  
  desc "Deploy a beta build to Firebase App Distribution"
  lane :deploy_firebase do |options|
    env = options[:env] || "dev"
    build(env: env)
    
    safe_app_name = ENV['APP_NAME'].downcase.gsub(' ', '-')
    firebase_app_distribution(
      app: ENV["FIREBASE_IOS_APP_ID"],
      groups: ENV["FIREBASE_TEST_GROUPS"],
      release_notes: options[:notes] || "New build for testing",
      ipa_path: "build/ios/#{env}/#{safe_app_name}.ipa"
    )
  end
  
  # Add more lanes as needed for iOS
end

#####################
# PLATFORM: Android
#####################
platform :android do
  desc "Build the Android application for specified environment"
  lane :build do |options|
    # Load environment-specific configuration
    env = options[:env] || "dev"
    prepare_build(platform: "android", env: env)
    
    # Determine the correct .env file for this environment
    env_file = env == "prod" ? ".env" : ".env.#{env}"
    
    # Set ENVFILE environment variable for react-native-config
    # This ensures react-native-config reads from the correct .env file
    ENV["ENVFILE"] = env_file
    UI.message("Setting ENVFILE=#{env_file} for react-native-config")
    
    # Build Android app with ENVFILE environment variable set
    # This is critical for react-native-config to load the correct .env file
    # Use absolute path to ensure the .env file is found correctly
    absolute_env_path = File.expand_path("../#{env_file}", __dir__)
    UI.message("Using absolute ENVFILE path: #{absolute_env_path}")
    
    # Clean first, then build - separate tasks to avoid C++ compilation issues
    gradle(
      task: "clean",
      project_dir: "android"
    )
    
    # Determine the correct gradle task based on environment
    gradle_task = case env
                  when "dev"
                    "bundleDevRelease"
                  when "staging"
                    "bundleStagingRelease"
                  when "prod"
                    "bundleProdRelease"
                  else
                    "bundleRelease"
                  end
    
    gradle(
      task: gradle_task,
      project_dir: "android",
      properties: {
        "RELEASE_UPLOAD_STORE_FILE" => ENV["ANDROID_KEYSTORE_PATH"],
        "RELEASE_UPLOAD_STORE_PASSWORD" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "RELEASE_UPLOAD_KEY_ALIAS" => ENV["ANDROID_KEY_ALIAS"],
        "RELEASE_UPLOAD_KEY_PASSWORD" => ENV["ANDROID_KEY_PASSWORD"],
        "versionCode" => ENV["ANDROID_VERSION_CODE"],
        "versionName" => ENV["ANDROID_VERSION_NAME"],
        "ENVFILE" => absolute_env_path
      }
    )
    
    # Move and rename AAB to consistent location
    # Use absolute path to ensure it's accessible from mobile app root
    build_dir = File.expand_path("../build/android/#{env}", __dir__)
    sh("mkdir -p '#{build_dir}'")
    
    # Use the actual AAB path from gradle output
    aab_path = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    if aab_path && File.exist?(aab_path)
      # Create a safe filename by replacing spaces with underscores
      safe_app_name = ENV['APP_NAME'].downcase.gsub(' ', '-')
      target_path = "#{build_dir}/#{safe_app_name}.aab"
      sh("cp '#{aab_path}' '#{target_path}'")
      UI.message("AAB copied to: #{target_path}")
      
      # Store the target path for use in upload actions
      lane_context[:CUSTOM_AAB_PATH] = target_path
    else
      UI.user_error!("AAB file not found at expected location: #{aab_path}")
    end
  end
  
  desc "Release to Google Play Store"
  lane :release_playstore do |options|
    env = options[:env] || "prod"
    build(env: env)
    
    upload_to_play_store(
      track: ENV["ANDROID_TRACK"] || "prod",
      release_status: ENV["ANDROID_RELEASE_STATUS"] || "completed",
      aab: lane_context[:CUSTOM_AAB_PATH]
    )
  end
  
  desc "Deploy a beta build to Google Play Beta track"
  lane :deploy_play_beta do |options|
    env = options[:env] || "staging"
    build(env: env)
    
    upload_to_play_store(
      track: "beta",
      release_status: "completed",
      aab: lane_context[:CUSTOM_AAB_PATH]
    )
  end
  
  desc "Deploy a beta build to Firebase App Distribution"
  lane :deploy_firebase do |options|
    env = options[:env] || "dev"
    
    # Firebase App Distribution requires APK, so build APK specifically
    prepare_build(platform: "android", env: env)
    
    # Determine the correct .env file for this environment
    env_file = env == "prod" ? ".env" : ".env.#{env}"
    
    # Set ENVFILE environment variable for react-native-config
    ENV["ENVFILE"] = env_file
    UI.message("Setting ENVFILE=#{env_file} for react-native-config")
    
    # Build Android APK for Firebase (Firebase doesn't support AAB)
    absolute_env_path = File.expand_path("../#{env_file}", __dir__)
    UI.message("Using absolute ENVFILE path: #{absolute_env_path}")
    
    # Clean first, then build APK - separate tasks to avoid C++ compilation issues
    gradle(
      task: "clean",
      project_dir: "android"
    )
    
    # Determine the correct gradle task based on environment for APK
    gradle_task_apk = case env
                      when "dev"
                        "assembleDevRelease"
                      when "staging"
                        "assembleStagingRelease"
                      when "prod"
                        "assembleProdRelease"
                      else
                        "assembleRelease"
                      end
    
    gradle(
      task: gradle_task_apk,
      project_dir: "android",
      properties: {
        "RELEASE_UPLOAD_STORE_FILE" => ENV["ANDROID_KEYSTORE_PATH"],
        "RELEASE_UPLOAD_STORE_PASSWORD" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "RELEASE_UPLOAD_KEY_ALIAS" => ENV["ANDROID_KEY_ALIAS"],
        "RELEASE_UPLOAD_KEY_PASSWORD" => ENV["ANDROID_KEY_PASSWORD"],
        "versionCode" => ENV["ANDROID_VERSION_CODE"],
        "versionName" => ENV["ANDROID_VERSION_NAME"],
        "ENVFILE" => absolute_env_path
      }
    )
    
    # Move and rename APK for Firebase
    build_dir = File.expand_path("../build/android/#{env}", __dir__)
    sh("mkdir -p '#{build_dir}'")
    
    # Use the actual APK path from gradle output
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    if apk_path && File.exist?(apk_path)
      safe_app_name = ENV['APP_NAME'].downcase.gsub(' ', '-')
      target_path = "#{build_dir}/#{safe_app_name}.apk"
      sh("cp '#{apk_path}' '#{target_path}'")
      UI.message("APK copied to: #{target_path}")
      
      firebase_app_distribution(
        app: ENV["FIREBASE_ANDROID_APP_ID"],
        groups: ENV["FIREBASE_TEST_GROUPS"],
        release_notes: options[:notes] || "New build for testing",
        apk_path: target_path
      )
    else
      UI.user_error!("APK file not found at expected location: #{apk_path}")
    end
  end
  
  # Add more lanes as needed for Android
end

# Cross-platform lanes
desc "Bump build numbers on both platforms"
lane :bump_version do |options|
  # Bump iOS build number
  increment_build_number(
    xcodeproj: "ios/#{ENV['APP_NAME']}.xcodeproj"
  )
  
  # Bump Android version code
  current_version_code = google_play_track_version_codes(
    track: "prod",
    json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"]
  )[0]
  
  # Update build.gradle with new version code
  new_version_code = current_version_code + 1
  sh("sed -i '' 's/versionCode \\([0-9]\\+\\)/versionCode #{new_version_code}/' android/app/build.gradle")
end