module Fastlane
  module Helper
    # Prepares build environment for a specific platform and environment
    def self.prepare_build(platform:, env:)
      UI.message("Preparing #{platform} build for #{env} environment")
      
      # Common build preparation tasks
      # Git status check can be enabled by setting SKIP_GIT_CLEAN_CHECK=false
      if ENV["SKIP_GIT_CLEAN_CHECK"] != "true"
        UI.message("Skipping git clean check (set SKIP_GIT_CLEAN_CHECK=true to enable)")
      end
      
      # Environment-specific tasks
      case env
      when "dev"
        UI.message("Setting up dev environment")
        # Dev specific setup
      when "staging"
        UI.message("Setting up staging environment")
        # Staging specific setup
      when "prod"
        UI.message("Setting up prod environment")
        # Production specific setup
        # Add extra verification steps for production
        UI.confirm("Are you sure you want to deploy to PRODUCTION?") unless ENV["CI"]
      end
      
      # Platform-specific tasks
      case platform
      when "ios"
        setup_ios_signing(env: env)
      when "android"
        setup_android_signing(env: env)
      end
    end
    
    # Gets the match type for iOS signing based on environment
    def self.get_match_type(env:)
      case env
      when "dev"
        "development"
      when "staging"
        "appstore"
      when "prod"
        "appstore"
      end
    end
    
    # Validates iOS signing requirements
    def self.setup_ios_signing(env:)
      UI.message("Setting up iOS signing for #{env}")
      
      # Verify required env variables are present
      required_vars = [
        "IOS_APP_IDENTIFIER",
        "MATCH_KEYCHAIN_NAME",
        "MATCH_KEYCHAIN_PASSWORD"
      ]
      
      missing_vars = required_vars.select { |var| ENV[var].nil? || ENV[var].empty? }
      
      unless missing_vars.empty?
        UI.error("Missing required environment variables: #{missing_vars.join(', ')}")
        raise "Missing environment variables for iOS signing"
      end
      
      UI.success("iOS signing configuration validated")
    end
    
    # Sets up Android signing configuration
    def self.setup_android_signing(env:)
      UI.message("Setting up Android signing for #{env}")
      
      # Verify keystore exists
      keystore_path = ENV["ANDROID_KEYSTORE_PATH"]
      # Build the full path to the keystore file
      expected_keystore_path = File.expand_path("../../android/app/#{keystore_path}", __dir__)
      unless File.exist?(expected_keystore_path)
        UI.error("Keystore file not found at: #{expected_keystore_path}")
        UI.error("Please ensure the keystore file exists or set ANDROID_KEYSTORE_PATH environment variable")
        raise "Keystore file not found"
      end
      UI.success("Keystore found at: #{expected_keystore_path}")
      
      # Verify all required env variables are present
      required_vars = [
        "ANDROID_KEYSTORE_PASSWORD",
        "ANDROID_KEY_ALIAS",
        "ANDROID_KEY_PASSWORD"
      ]
      
      missing_vars = required_vars.select { |var| ENV[var].nil? || ENV[var].empty? }
      
      unless missing_vars.empty?
        UI.error("Missing required environment variables: #{missing_vars.join(', ')}")
        raise "Missing environment variables for Android signing"
      end
    end
    
    # Validates app version before release
    def self.validate_version(platform:)
      UI.message("Validating version for #{platform}")
      
      case platform
      when "ios"
        # Read current version from Info.plist
        current_version = get_info_plist_value(
          path: "ios/#{ENV['APP_NAME']}/Info.plist",
          key: "CFBundleShortVersionString"
        )
        
        # Verify version follows semantic versioning
        unless current_version =~ /^\d+\.\d+\.\d+$/
          UI.error("iOS version '#{current_version}' doesn't follow semantic versioning (x.y.z)")
          raise "Invalid version format"
        end
      
      when "android"
        # Read current version from build.gradle
        build_gradle = File.read("android/app/build.gradle")
        version_name = build_gradle.match(/versionName "([^"]+)"/)[1]
        
        # Verify version follows semantic versioning
        unless version_name =~ /^\d+\.\d+\.\d+$/
          UI.error("Android version '#{version_name}' doesn't follow semantic versioning (x.y.z)")
          raise "Invalid version format"
        end
      end
      
      UI.success("Version validation passed")
    end
    
    # Gets the current Android version code from local sources (env file or build.gradle)
    # Returns nil if not found
    def self.get_local_android_version_code
      # Try environment variable first
      env_version_code = ENV["ANDROID_VERSION_CODE"] || ENV["APP_VERSION_CODE"]
      if env_version_code && !env_version_code.empty?
        return env_version_code.to_i
      end
      
      # Try reading from build.gradle default value
      begin
        build_gradle_path = File.expand_path("../../android/app/build.gradle", __dir__)
        if File.exist?(build_gradle_path)
          build_gradle = File.read(build_gradle_path)
          
          # Try to find versionCode in defaultConfig
          version_code_match = build_gradle.match(/versionCode\s+(\d+)/)
          if version_code_match
            return version_code_match[1].to_i
          end
        end
      rescue => e
        UI.important("Could not read version code from build.gradle: #{e.message}")
      end
      
      nil
    end
    
    # Increments Android version code based on current version code
    def self.increment_android_version_code(current_version_code:)
      if current_version_code.nil? || current_version_code < 1
        UI.important("Invalid version code, starting from 1")
        return 1
      end
      
      new_version_code = current_version_code + 1
      UI.success("Incrementing version code from #{current_version_code} to #{new_version_code}")
      new_version_code
    end
  end
end

# Make helper methods available to lanes
def prepare_build(options)
  Fastlane::Helper.prepare_build(
    platform: options[:platform],
    env: options[:env]
  )
end

def validate_version(options)
  Fastlane::Helper.validate_version(
    platform: options[:platform]
  )
end

def get_match_type(env:)
  Fastlane::Helper.get_match_type(env: env)
end

def get_local_android_version_code
  Fastlane::Helper.get_local_android_version_code
end

def increment_android_version_code(options)
  Fastlane::Helper.increment_android_version_code(
    current_version_code: options[:current_version_code]
  )
end