{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./src/types"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@components": ["src/components"],
      "@screens/*": ["src/screens/*"],
      "@navigation/*": ["src/navigation/*"],
      "@utils/*": ["src/utils/*"],
      "@hooks/*": ["src/hooks/*"],
      "@app-types/*": ["src/types/*"],
      "@app-types": ["src/types"],
      "@assets/*": ["src/assets/*"],
      "@theme/*": ["src/theme/*"],
      "@theme": ["src/theme"],
      "@constants/*": ["src/constants/*"],
      "@configs/*": ["src/configs/*"],
      "@configs": ["src/configs"],
      "@contexts/*": ["src/contexts/*"],
      "@contexts": ["src/contexts"],
      "@services/*": ["src/services/*"],
      "@services": ["src/services"],
      "@/*": ["src/*"],
      "@motorove/shared": ["../../shared"],
      "@motorove/shared/*": ["../../shared/*"]
    }
  }
}
