{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "../prisma/generated",
        "outDir": "dist/prisma"
      },
      {
        "include": "./core/i18n/locales",
        "outDir": "dist/src/"
      }
    ]
  }
}
