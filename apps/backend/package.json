{
  "name": "@motorove/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "NODE_ENV=development nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:staging": "NODE_ENV=staging node dist/src/main",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "clean": "rm -rf .turbo node_modules dist",
    "prisma:generate:dev": "dotenv -e .env.dev -- prisma generate --schema=./prisma/schema.prisma",
    "prisma:generate:staging": "dotenv -e .env.staging -- prisma generate --schema=./prisma/schema.prisma",
    "prisma:generate:prod": "dotenv -e .env -- prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:staging": "dotenv -e .env.staging -- prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:prod": "dotenv -e .env -- prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy:dev": "dotenv -e .env.dev -- prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy:staging": "dotenv -e .env.staging -- prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy:prod": "dotenv -e .env -- prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:migrate:reset:dev": "dotenv -e .env.dev -- prisma migrate reset --schema=./prisma/schema.prisma",
    "prisma:migrate:reset:staging": "dotenv -e .env.staging -- prisma migrate reset --schema=./prisma/schema.prisma",
    "prisma:migrate:reset:prod": "dotenv -e .env -- prisma migrate reset --schema=./prisma/schema.prisma",
    "prisma:studio:dev": "dotenv -e .env.dev -- prisma studio --schema=./prisma/schema.prisma",
    "prisma:studio:staging": "dotenv -e .env.staging -- prisma studio --schema=./prisma/schema.prisma",
    "prisma:studio:prod": "dotenv -e .env -- prisma studio --schema=./prisma/schema.prisma",
    "prisma:seed:dev": "dotenv -e .env.dev -- prisma db seed",
    "prisma:seed:staging": "dotenv -e .env.staging -- prisma db seed",
    "prisma:seed:prod": "dotenv -e .env -- prisma db seed",
    "prisma:db:push:dev": "dotenv -e .env.dev -- prisma db push --schema=./prisma/schema.prisma",
    "prisma:db:push:staging": "dotenv -e .env.staging -- prisma db push --schema=./prisma/schema.prisma",
    "prisma:db:push:prod": "dotenv -e .env -- prisma db push --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@apollo/server": "4.12.0",
    "@motorove/shared": "workspace:*",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bull": "11.0.3",
    "@nestjs/common": "11.0.1",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.1",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/platform-ws": "11.1.0",
    "@nestjs/websockets": "11.1.0",
    "@prisma/client": "6.7.0",
    "@sentry/node": "9.15.0",
    "@sentry/profiling-node": "9.15.0",
    "@supabase/supabase-js": "2.49.4",
    "@tensorflow/tfjs-node": "4.22.0",
    "axios": "1.12.1",
    "bullmq": "5.58.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "firebase-admin": "13.4.0",
    "graphql": "16.11.0",
    "graphql-type-json": "0.3.2",
    "joi": "17.13.3",
    "leo-profanity": "1.8.0",
    "nest-winston": "1.10.2",
    "nsfwjs": "4.2.1",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.1",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.10.7",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/leo-profanity": "1.5.4",
    "@types/node": "22.10.7",
    "@types/redis": "4.0.11",
    "@types/supertest": "6.0.2",
    "dotenv-cli": "10.0.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "prisma": "6.7.0",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@9.6.0",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
