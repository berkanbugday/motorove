// Models
model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  avatar            String?
  supabaseId        String   @unique
  email             String   @unique
  bio               String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)
  hasCompletedSetup Boolean  @default(false)

  // New fields
  dateOfBirth  DateTime?
  gender       Gender?
  ridingStyles RidingStyle[] @default([])
  interests    Interest[]    @default([])

  // Relations
  createdGroups        Group[]           @relation("GroupCreatedBy")
  updatedGroups        Group[]           @relation("GroupUpdatedBy")
  groupMemberships     GroupMembership[] @relation("UserGroupMembership")
  createdMemberships   GroupMembership[] @relation("MembershipCreatedBy")
  updatedMemberships   GroupMembership[] @relation("MembershipUpdatedBy")
  notifications        Notification[]
  createdNotifications Notification[]    @relation("NotificationCreatedBy")
  updatedNotifications Notification[]    @relation("NotificationUpdatedBy")
  deviceTokens         DeviceToken[]
  posts                Post[]
  updatedPosts         Post[]            @relation("PostUpdatedBy")
  comments             Comment[]
  updatedComments      Comment[]         @relation("CommentUpdatedBy")
  postLikes            PostLike[]
  postSaves            PostSave[]
  socialMediaProfiles  SocialMedia[]
  updatedSocialMedia   SocialMedia[]     @relation("SocialMediaUpdatedBy")

  // Garage system relations
  garages            Garage[]     @relation("UserGarages")
  updatedGarages     Garage[]     @relation("GarageUpdatedBy")
  createdMotorcycles Motorcycle[] @relation("MotorcycleCreatedBy")
  updatedMotorcycles Motorcycle[] @relation("MotorcycleUpdatedBy")
  createdEquipment   Equipment[]  @relation("EquipmentCreatedBy")
  updatedEquipment   Equipment[]  @relation("EquipmentUpdatedBy")
  userSetting        UserSetting?

  // Following system relations
  followers UserFollowing[] @relation("UserFollowers")

  // Support requests
  supportRequests        SupportRequest[]
  updatedSupportRequests SupportRequest[] @relation("SupportRequestUpdatedBy")
  following              UserFollowing[]  @relation("UserFollowing")

  // Event relations
  createdEvents       Event[]            @relation("EventCreatedBy")
  updatedEvents       Event[]            @relation("EventUpdatedBy")
  eventParticipations EventParticipant[] @relation("EventParticipantCreatedBy")
  receivedInvitations EventInvitation[]  @relation("ReceivedInvitations")

  // Added relations for EventInvitation
  createdEventInvitations EventInvitation[] @relation("EventInvitationCreatedBy")
  updatedEventInvitations EventInvitation[] @relation("EventInvitationUpdatedBy")

  // EventParticipant relations
  updatedEventParticipants EventParticipant[] @relation("EventParticipantUpdatedBy")

  @@index([supabaseId])
  @@index([isActive])
  @@index([ridingStyles])
  @@index([gender])
  @@index([interests])
  @@index([cityId])
}

// New model for user garages
model Garage {
  id          String       @id @default(uuid())
  name        String
  description String?
  equipments  Equipment[]
  motorcycles Motorcycle[] // Add relation to motorcycles

  // Base model fields
  createdById String
  createdBy   User     @relation("UserGarages", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("GarageUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([isActive])
}

// New model for motorcycles
model Motorcycle {
  id          String   @id @default(uuid())
  brand       String
  model       String
  year        Int?
  description String?
  images      String[] @default([])
  garageId    String // Change to reference garage instead of user
  garage      Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  // Base model fields
  createdById String
  createdBy   User     @relation("MotorcycleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("MotorcycleUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([garageId])
  @@index([brand])
  @@index([isActive])
}

// New model for equipment in garages
model Equipment {
  id          String        @id @default(uuid())
  name        String
  type        EquipmentType
  brand       String
  model       String
  year        Int?
  description String?
  images      String[]      @default([])
  garageId    String
  garage      Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)

  // Base model fields
  createdById String
  createdBy   User     @relation("EquipmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EquipmentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([garageId])
  @@index([type])
  @@index([brand])
  @@index([isActive])
}

// New model for social media profiles
model SocialMedia {
  id       String              @id @default(uuid())
  platform SocialMediaPlatform
  username String
  url      String

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("SocialMediaUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([createdById, platform])
  @@index([createdById])
  @@index([platform])
  @@index([isActive])
}

model City {
  id    String @id @default(uuid())
  value String

  // Relations
  groups Group[]
  users  User[]

  @@index([value])
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String
  logo            String?
  cover           String?
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  privacy         GroupPrivacy
  tags            GroupTag[] // Changed from GroupTag[] relation to GroupTag[] enum array
  membersCapacity Int?

  // Base model fields
  createdById String
  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  memberships GroupMembership[]
  posts       Post[]
  events      Event[]

  @@index([cityId])
  @@index([privacy])
}

model GroupMembership {
  id      String          @id @default(uuid())
  groupId String
  group   Group           @relation(fields: [groupId], references: [id])
  userId  String
  user    User            @relation("UserGroupMembership", fields: [userId], references: [id])
  role    GroupMemberRole
  status  ApprovalStatus  @default(PENDING)

  // Base model fields
  createdById String
  createdBy   User     @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@index([role])
  @@index([isActive])
}

model Notification {
  id      String              @id @default(uuid())
  title   String
  body    String
  type    NotificationType
  channel NotificationChannel
  data    Json?               @default("{}")
  userId  String
  user    User                @relation(fields: [userId], references: [id])
  status  NotificationStatus  @default(PENDING)
  read    Boolean             @default(false)

  // Base model fields
  createdById String
  createdBy   User     @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("NotificationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([read])
  @@index([createdAt]) // Added index for filtering by creation date
  @@index([isActive])
}

model DeviceToken {
  id         String   @id @default(uuid())
  token      String
  type       String // 'ios' or 'android'
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([userId])
  @@index([userId])
  @@index([isActive])
  @@index([type])
}

model Post {
  id        String     @id @default(uuid())
  content   String
  images    String[]
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  comments  Comment[]
  likes     PostLike[] // Added relation to PostLike
  saves     PostSave[] // Added relation to PostSave
  addresses Address[] // Added relation to Address

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([groupId])
  @@index([createdAt]) // Added for feed sorting
  @@index([isActive])
}

model Comment {
  id      String @id @default(uuid())
  content String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String

  // Parent-child relationship for comment replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("CommentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([postId])
  @@index([parentId])
  @@index([createdAt]) // Added for sorting
  @@index([isActive])
}

// New model for post likes
model PostLike {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// New model for post saves
model PostSave {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// New model for addresses with support for both posts and events
model Address {
  id        String      @id @default(uuid())
  address   String
  country   String?
  language  Language // Change from String to Language enum
  type      AddressType
  latitude  Float
  longitude Float

  // Relations - one address belongs to either a post, an event, or a business
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String?

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?   @unique

  @@unique([postId, language, type]) // Ensure unique addresses per post/language/type
  @@unique([eventId, language, type]) // Ensure unique addresses per event/language/type
  @@unique([businessId, language, type]) // Ensure unique addresses per business/language/type
  @@index([postId])
  @@index([eventId])
  @@index([businessId])
  @@index([language])
  @@index([type])
  @@index([country])
  @@index([latitude, longitude]) // Added for geospatial queries
}

// Business model
model Business {
  id            String             @id @default(uuid())
  name          String
  mainCategory  BusinessCategory
  subCategories BusinessCategory[]
  areaCode      String?
  phoneNumber   String
  verified      Boolean            @default(false)
  status        ApprovalStatus     @default(PENDING)

  // Relations
  address      Address?
  descriptions BusinessDescription[]
  workingHours WorkingHour[]

  // Base model fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([name])
  @@index([mainCategory])
  @@index([verified])
  @@index([status])
  @@index([isActive])
}

// Business description model for multi-language support
model BusinessDescription {
  id          String   @id @default(uuid())
  description String   @db.Text
  language    Language

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  // Base model fields
  isActive Boolean @default(true)

  @@unique([businessId, language]) // Ensure unique description per business/language
  @@index([businessId])
  @@index([language])
  @@index([isActive])
}

// Working hours model for businesses
model WorkingHour {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek
  startHour String? // Format: "09:00" or null if closed
  endHour   String? // Format: "18:00" or null if closed
  isOpen24h Boolean   @default(false)

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  // Base model fields
  isActive Boolean @default(true)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@index([dayOfWeek])
  @@index([isActive])
}

// User following relationships
model UserFollowing {
  id          String         @id @default(uuid())
  followerId  String
  follower    User           @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User           @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  status      ApprovalStatus @default(PENDING)
  isActive    Boolean        @default(true)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
  @@index([status])
  @@index([isActive])
}

// Event model
model Event {
  id              String      @id @default(uuid())
  title           String      @db.VarChar(100)
  description     String      @db.Text
  eventType       EventType
  status          EventStatus @default(PUBLISHED)
  startDateTime   DateTime
  endDateTime     DateTime?
  maxParticipants Int?
  isPrivate       Boolean     @default(false)
  images          String[]

  // Ride-specific fields
  roadType           RoadType?
  difficultyLevel    DifficultyLevel?
  routeDescription   String?          @db.Text
  restStops          String?          @db.Text
  campingInfo        String?          @db.Text
  equipmentChecklist String?          @db.Text

  // Training-specific fields
  instructorInfo  String?          @db.Text
  topicsCovered   String?          @db.Text
  experienceLevel ExperienceLevel?
  price           Float?

  // Base model fields
  createdById String
  createdBy   User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relationships
  participants  EventParticipant[]
  invitations   EventInvitation[]
  addresses     Address[]
  invitedGroups Group[]

  @@index([eventType])
  @@index([status])
  @@index([startDateTime])
  @@index([createdById])
  @@index([isActive])
  @@index([isPrivate])
}

// Event participant model
model EventParticipant {
  id      String                 @id @default(uuid())
  event   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  status  EventParticipantStatus @default(JOINED)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventParticipantCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventParticipantUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, createdById])
  @@index([eventId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([isActive])
}

// Event invitation model
model EventInvitation {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User           @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    ApprovalStatus @default(PENDING)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventInvitationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventInvitationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, inviteeId])
  @@index([eventId])
  @@index([createdById])
  @@index([inviteeId])
  @@index([status])
  @@index([createdAt])
  @@index([isActive])
}

// User settings model
model UserSetting {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Privacy settings
  autoAcceptFollowers Boolean @default(false)

  // Notification permission fields
  notificationPermission NotificationPermission @default(UNKNOWN)

  // Notification preferences
  notificationPreferences Json? // Map of NotificationType to boolean

  // Base model fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([notificationPermission])
}

model SupportRequest {
  id         String          @id @default(uuid())
  category   SupportCategory
  subject    String
  message    String
  deviceInfo Json?

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation(name: "SupportRequestUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([category])
  @@index([createdById])
  @@index([isActive])
}
