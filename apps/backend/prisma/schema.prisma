// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum GroupMembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SYSTEM
  NEW_MESSAGE
  GROUP_INVITE
  GROUP_JOIN
  GROUP_LEAVE
  RIDE_INVITATION
  RIDE_STARTED
  RIDE_COMPLETED
  MAINTENANCE_REMINDER
  FRIEND_REQUEST
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// Models
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  firstName  String?
  lastName   String?
  avatar     String?
  supabaseId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)

  // Relations
  createdGroups        Group[]           @relation("GroupCreatedBy")
  updatedGroups        Group[]           @relation("GroupUpdatedBy")
  groupMemberships     GroupMembership[] @relation("UserGroupMembership")
  createdMemberships   GroupMembership[] @relation("MembershipCreatedBy")
  updatedMemberships   GroupMembership[] @relation("MembershipUpdatedBy")
  notifications        Notification[]
  createdNotifications Notification[]    @relation("NotificationCreatedBy")
  updatedNotifications Notification[]    @relation("NotificationUpdatedBy")
  deviceTokens         DeviceToken[]
}

model City {
  id    String @id @default(uuid())
  value String

  // Relations
  groups Group[]
}

model GroupTag {
  id       String  @id @default(uuid())
  value    String
  isActive Boolean @default(true)

  // Relations
  groups Group[] @relation("GroupToTags")
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String
  logo            String?
  cover           String?
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  privacy         GroupPrivacy
  tags            GroupTag[]   @relation("GroupToTags")
  membersCapacity Int?

  // Base model fields
  createdById String
  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  memberships GroupMembership[]
}

model GroupMembership {
  id       String                @id @default(uuid())
  groupId  String
  group    Group                 @relation(fields: [groupId], references: [id])
  userId   String
  user     User                  @relation("UserGroupMembership", fields: [userId], references: [id])
  role     GroupMemberRole
  status   GroupMembershipStatus @default(PENDING)
  joinedAt DateTime              @default(now())

  // Base model fields
  createdById String
  createdBy   User     @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([groupId, userId])
}

model Notification {
  id     String             @id @default(uuid())
  title  String
  body   String
  type   NotificationType
  data   Json?              @default("{}")
  userId String
  user   User               @relation(fields: [userId], references: [id])
  status NotificationStatus @default(PENDING)
  read   Boolean            @default(false)

  // Base model fields
  createdById String
  createdBy   User     @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("NotificationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([read])
}

model DeviceToken {
  token      String
  type       String // 'ios' or 'android'
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@id([token, userId])
  @@index([userId])
  @@index([isActive])
}
