// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env.dev("DATABASE_URL")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  SYSTEM
  NEW_MESSAGE
  GROUP_INVITE
  GROUP_JOIN
  GROUP_LEAVE
  RIDE_INVITATION
  RIDE_STARTED
  RIDE_COMPLETED
  MAINTENANCE_REMINDER
  FRIEND_REQUEST
  GROUP_MEMBERSHIP_STATUS_UPDATED
  GROUP_MEMBERSHIP_ROLE_UPDATED
  GROUP_MEMBERSHIP_REMOVED
  GROUP_MEMBERSHIP_ADDED
  GROUP_MEMBERSHIP_REQUEST
  GROUP_MEMBERSHIP_REQUEST_ACCEPTED
  GROUP_MEMBERSHIP_REQUEST_REJECTED
  EVENT_INVITATION
  EVENT_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  NOT_SENT
  DELIVERED
  FAILED
}

enum EventType {
  SOLO_RIDE
  GROUP_RIDE
  CAMPING_RIDE
  MEET_UP
  TRAINING
  SOCIAL_RESPONSIBILITY
}

enum RoadType {
  ASPHALT
  OFF_ROAD
  MIXED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum EventParticipantStatus {
  JOINED
  LEFT
}

enum AddressType {
  POST_LOCATION
  EVENT_MEETING_POINT
  EVENT_START_LOCATION
  EVENT_FINISH_LOCATION
}

enum Language {
  EN
  TR
}

// Models
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  firstName  String
  lastName   String
  avatar     String?
  supabaseId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)

  // Relations
  createdGroups        Group[]           @relation("GroupCreatedBy")
  updatedGroups        Group[]           @relation("GroupUpdatedBy")
  groupMemberships     GroupMembership[] @relation("UserGroupMembership")
  createdMemberships   GroupMembership[] @relation("MembershipCreatedBy")
  updatedMemberships   GroupMembership[] @relation("MembershipUpdatedBy")
  notifications        Notification[]
  createdNotifications Notification[]    @relation("NotificationCreatedBy")
  updatedNotifications Notification[]    @relation("NotificationUpdatedBy")
  deviceTokens         DeviceToken[]
  posts                Post[]
  updatedPosts         Post[]            @relation("PostUpdatedBy")
  comments             Comment[]
  updatedComments      Comment[]         @relation("CommentUpdatedBy")
  postLikes            PostLike[]
  postSaves            PostSave[]

  // Following system relations
  followers UserFollowing[] @relation("UserFollowers")
  following UserFollowing[] @relation("UserFollowing")

  // Event relations
  createdEvents       Event[]            @relation("EventCreatedBy")
  updatedEvents       Event[]            @relation("EventUpdatedBy")
  eventParticipations EventParticipant[]
  receivedInvitations EventInvitation[]  @relation("ReceivedInvitations")
  Event               Event?             @relation(fields: [eventId], references: [id])
  eventId             String?

  // Added relations for EventInvitation
  createdEventInvitations EventInvitation[] @relation("EventInvitationCreatedBy")
  updatedEventInvitations EventInvitation[] @relation("EventInvitationUpdatedBy")

  // EventParticipant relations
  createdEventParticipants EventParticipant[] @relation("EventParticipantCreatedBy")
  updatedEventParticipants EventParticipant[] @relation("EventParticipantUpdatedBy")

  @@index([email])
  @@index([supabaseId])
  @@index([isActive])
}

model City {
  id    String @id @default(uuid())
  value String

  // Relations
  groups Group[]
}

model GroupTag {
  id       String  @id @default(uuid())
  value    String
  isActive Boolean @default(true)

  // Relations
  groups Group[] @relation("GroupToTags")
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String
  logo            String?
  cover           String?
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  privacy         GroupPrivacy
  tags            GroupTag[]   @relation("GroupToTags")
  membersCapacity Int?

  // Base model fields
  createdById String
  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  memberships GroupMembership[]
  posts       Post[]
  events      Event[]

  @@index([cityId])
  @@index([privacy])
}

model GroupMembership {
  id       String           @id @default(uuid())
  groupId  String
  group    Group            @relation(fields: [groupId], references: [id])
  userId   String
  user     User             @relation("UserGroupMembership", fields: [userId], references: [id])
  role     GroupMemberRole
  status   InvitationStatus @default(PENDING)
  joinedAt DateTime         @default(now())

  // Base model fields
  createdById String
  createdBy   User     @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@index([role])
  @@index([isActive])
}

model Notification {
  id     String             @id @default(uuid())
  title  String
  body   String
  type   NotificationType
  data   Json?              @default("{}")
  userId String
  user   User               @relation(fields: [userId], references: [id])
  status NotificationStatus @default(PENDING)
  read   Boolean            @default(false)

  // Base model fields
  createdById String
  createdBy   User     @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("NotificationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([read])
  @@index([createdAt]) // Added index for filtering by creation date
  @@index([isActive])
}

model DeviceToken {
  token      String
  type       String // 'ios' or 'android'
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@id([token, userId])
  @@index([userId])
  @@index([isActive])
  @@index([type])
}

model Post {
  id        String     @id @default(uuid())
  content   String
  images    String[]
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  comments  Comment[]
  likes     PostLike[] // Added relation to PostLike
  saves     PostSave[] // Added relation to PostSave
  addresses Address[] // Added relation to Address

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([groupId])
  @@index([createdAt]) // Added for feed sorting
  @@index([isActive])
}

model Comment {
  id      String @id @default(uuid())
  content String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String

  // Parent-child relationship for comment replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("CommentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([postId])
  @@index([parentId])
  @@index([createdAt]) // Added for sorting
  @@index([isActive])
}

// New model for post likes
model PostLike {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// New model for post saves
model PostSave {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// New model for addresses with support for both posts and events
model Address {
  id        String      @id @default(uuid())
  address   String
  language  Language // Change from String to Language enum
  type      AddressType
  latitude  Float
  longitude Float

  // Relations - one address belongs to either a post or an event
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String?

  @@unique([postId, language, type]) // Ensure unique addresses per post/language/type
  @@unique([eventId, language, type]) // Ensure unique addresses per event/language/type
  @@index([postId])
  @@index([eventId])
  @@index([language])
  @@index([type])
  @@index([latitude, longitude]) // Added for geospatial queries
}

// User following relationships
model UserFollowing {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
}

// Event model
model Event {
  id              String    @id @default(uuid())
  title           String    @db.VarChar(100)
  description     String    @db.Text
  eventType       EventType
  startDateTime   DateTime
  endDateTime     DateTime?
  maxParticipants Int?
  isPrivate       Boolean   @default(false)
  images          String[]
  invitedUserIds  String[]  @default([]) // Added field from Event model
  invitedGroupIds String[]  @default([]) // Added field from Event model

  // Ride-specific fields
  roadType           RoadType?
  difficultyLevel    DifficultyLevel?
  routeDescription   String?          @db.Text
  restStops          String?          @db.Text
  campingInfo        String?          @db.Text
  equipmentChecklist String?          @db.Text

  // Training-specific fields
  instructorInfo  String?          @db.Text
  topicsCovered   String?          @db.Text
  experienceLevel ExperienceLevel?
  price           Float?

  // Base model fields
  createdById String
  createdBy   User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relationships
  participants  EventParticipant[]
  invitations   EventInvitation[]
  addresses     Address[]
  invitedGroups Group[]
  invitedUsers  User[]

  @@index([eventType])
  @@index([startDateTime])
  @@index([createdById])
  @@index([isActive])
  @@index([isPrivate])
}

// Event participant model
model EventParticipant {
  id      String                 @id @default(uuid())
  event   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  status  EventParticipantStatus @default(JOINED)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventParticipantCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventParticipantUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  User        User?    @relation(fields: [userId], references: [id])
  userId      String?

  @@unique([eventId, createdById])
  @@index([eventId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([isActive])
}

// Event invitation model
model EventInvitation {
  id        String           @id @default(uuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User             @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    InvitationStatus @default(PENDING)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventInvitationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventInvitationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, inviteeId])
  @@index([eventId])
  @@index([createdById])
  @@index([inviteeId])
  @@index([status])
  @@index([createdAt])
  @@index([isActive])
}
