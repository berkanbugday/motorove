// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum GroupMembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SYSTEM
  NEW_MESSAGE
  GROUP_INVITE
  GROUP_JOIN
  GROUP_LEAVE
  RIDE_INVITATION
  RIDE_STARTED
  RIDE_COMPLETED
  MAINTENANCE_REMINDER
  FRIEND_REQUEST
  GROUP_MEMBERSHIP_STATUS_UPDATED
  GROUP_MEMBERSHIP_ROLE_UPDATED
  GROUP_MEMBERSHIP_REMOVED
  GROUP_MEMBERSHIP_ADDED
  GROUP_MEMBERSHIP_REQUEST
  GROUP_MEMBERSHIP_REQUEST_ACCEPTED
  GROUP_MEMBERSHIP_REQUEST_REJECTED
}

enum NotificationStatus {
  PENDING
  SENT
  NOT_SENT
  DELIVERED
  FAILED
}

enum EventType {
  SOLO_RIDE
  GROUP_RIDE
  CAMPING_RIDE
  SOCIAL_MEET_UP
  WORKSHOP_TRAINING
  CHARITY_RIDE
}

enum RoadType {
  ASPHALT
  OFF_ROAD
  MIXED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

// Models
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  firstName  String?
  lastName   String?
  avatar     String?
  supabaseId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)

  // Relations
  createdGroups        Group[]           @relation("GroupCreatedBy")
  updatedGroups        Group[]           @relation("GroupUpdatedBy")
  groupMemberships     GroupMembership[] @relation("UserGroupMembership")
  createdMemberships   GroupMembership[] @relation("MembershipCreatedBy")
  updatedMemberships   GroupMembership[] @relation("MembershipUpdatedBy")
  notifications        Notification[]
  createdNotifications Notification[]    @relation("NotificationCreatedBy")
  updatedNotifications Notification[]    @relation("NotificationUpdatedBy")
  deviceTokens         DeviceToken[]
  posts                Post[]
  updatedPosts         Post[]            @relation("PostUpdatedBy")
  comments             Comment[]
  updatedComments      Comment[]         @relation("CommentUpdatedBy")
  postLikes            PostLike[]
  postSaves            PostSave[]

  // Following system relations
  followers UserFollowing[] @relation("UserFollowers")
  following UserFollowing[] @relation("UserFollowing")

  // Event invitations
  sentInvitations     EventInvitation[] @relation("SentInvitations")
  receivedInvitations EventInvitation[] @relation("ReceivedInvitations")
}

model City {
  id    String @id @default(uuid())
  value String

  // Relations
  groups Group[]
}

model GroupTag {
  id       String  @id @default(uuid())
  value    String
  isActive Boolean @default(true)

  // Relations
  groups Group[] @relation("GroupToTags")
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String
  logo            String?
  cover           String?
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  privacy         GroupPrivacy
  tags            GroupTag[]   @relation("GroupToTags")
  membersCapacity Int?

  // Base model fields
  createdById String
  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  memberships GroupMembership[]
  posts       Post[]
}

model GroupMembership {
  id       String                @id @default(uuid())
  groupId  String
  group    Group                 @relation(fields: [groupId], references: [id])
  userId   String
  user     User                  @relation("UserGroupMembership", fields: [userId], references: [id])
  role     GroupMemberRole
  status   GroupMembershipStatus @default(PENDING)
  joinedAt DateTime              @default(now())

  // Base model fields
  createdById String
  createdBy   User     @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([groupId, userId])
}

model Notification {
  id     String             @id @default(uuid())
  title  String
  body   String
  type   NotificationType
  data   Json?              @default("{}")
  userId String
  user   User               @relation(fields: [userId], references: [id])
  status NotificationStatus @default(PENDING)
  read   Boolean            @default(false)

  // Base model fields
  createdById String
  createdBy   User     @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("NotificationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([read])
}

model DeviceToken {
  token      String
  type       String // 'ios' or 'android'
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@id([token, userId])
  @@index([userId])
  @@index([isActive])
}

model Post {
  id        String        @id @default(uuid())
  content   String
  images    String[]
  latitude  Float? // Added latitude field
  longitude Float? // Added longitude field
  group     Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  comments  Comment[]
  likes     PostLike[] // Added relation to PostLike
  saves     PostSave[] // Added relation to PostSave
  addresses PostAddress[] // Added relation to PostAddress

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([groupId])
}

model Comment {
  id      String @id @default(uuid())
  content String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String

  // Parent-child relationship for comment replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("CommentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([postId])
  @@index([parentId])
}

// New model for post likes
model PostLike {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// New model for post saves
model PostSave {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// New model for post addresses with multi-language support
model PostAddress {
  id       String @id @default(uuid())
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  address  String
  language String // Language code (e.g., 'en', 'tr', 'es', etc.)

  @@unique([postId, language])
  @@index([postId])
  @@index([language])
}

// User following relationships
model UserFollowing {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Event invitation for users (used for private solo rides)
model EventInvitation {
  id        String   @id @default(uuid())
  eventId   String // Will add relation when implementing events
  inviterId String
  inviter   User     @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User     @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, inviteeId])
  @@index([eventId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([status])
}
