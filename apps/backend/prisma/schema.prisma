// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  SYSTEM
  NEW_MESSAGE
  GROUP_INVITE
  GROUP_JOIN
  GROUP_LEAVE
  RIDE_INVITATION
  RIDE_STARTED
  RIDE_COMPLETED
  MAINTENANCE_REMINDER
  FRIEND_REQUEST
  GROUP_MEMBERSHIP_STATUS_UPDATED
  GROUP_MEMBERSHIP_ROLE_UPDATED
  GROUP_MEMBERSHIP_REMOVED
  GROUP_MEMBERSHIP_ADDED
  GROUP_MEMBERSHIP_REQUEST
  GROUP_MEMBERSHIP_REQUEST_ACCEPTED
  GROUP_MEMBERSHIP_REQUEST_REJECTED
  EVENT_INVITATION
  EVENT_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  NOT_SENT
  DELIVERED
  FAILED
}

enum NotificationPermission {
  ALLOWED
  NOT_ALLOWED
  UNKNOWN
}

enum NotificationChannel {
  PUSH
  EMAIL
}

enum EventType {
  SOLO_RIDE
  GROUP_RIDE
  CAMPING_RIDE
  MEET_UP
  TRAINING
  MOTOFEST
  SOCIAL_RESPONSIBILITY
}

enum RoadType {
  ASPHALT
  OFF_ROAD
  MIXED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum EventParticipantStatus {
  JOINED
  LEFT
}

enum AddressType {
  POST_LOCATION
  EVENT_MEETING_POINT
  EVENT_START_LOCATION
  EVENT_FINISH_LOCATION
}

enum Language {
  EN
  TR
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum RidingStyle {
  TOURING
  COMMUTING
  OFF_ROAD
  ADVENTURE
  TRACK
  CAFE_RACER
  CRUISER
  SPORT
  STUNT
  GROUP_RIDE
  SOLO_RIDE
  TOURING_WITH_CAMPING
  SCOOTER
  CUSTOM
}

enum EquipmentType {
  FULL_FACE_HELMET
  MODULAR_HELMET
  OPEN_FACE_HELMET
  OFF_ROAD_HELMET
  HALF_HELMET
  RIDING_JACKET
  ARMOR
  BACK_PROTECTOR
  AIRBAG_VEST
  RIDING_PANTS
  KNEE_GUARDS
  GLOVES
  BOOTS
  GOGGLES
  RAIN_SUIT
  INTERCOM
  CAMERA
  GPS_DEVICE
  FIRST_AID_KIT
}

enum SocialMediaPlatform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  YOUTUBE
  TIKTOK
  LINKEDIN
}

enum Interest {
  MOTORCYCLE_CUSTOMIZATION
  DIY_MAINTENANCE
  VINTAGE_MOTORCYCLES
  ELECTRIC_MOTORCYCLES
  RIDING_SKILLS
  MOTO_PHOTOGRAPHY
  CONTENT_CREATION
  MEETING_RIDERS
  COMMUNITY_EVENTS
  MOTO_FESTIVALS
  EXPLORING_NATURE
  MOUNTAIN_ROADS
  COASTAL_RIDES
  CROSS_BORDER_TRIPS
}

// Add new GroupTag enum
enum GroupTag {
  BEGINNER
  ADVANCED
  CAMPING
  TOURING
  OFF_ROAD
  CITY_RIDES
  TRACK_DAY
  SCOOTER_GROUP
  WOMEN_ONLY
  WEEKEND_RIDERS
  CROSS_COUNTRY
  BORDER_RIDES
  DIY_AND_CUSTOM
  MECHANIC_DISCUSSION
  EVENT_ORGANIZERS
  SOCIAL_RESPONSIBILITY
}

// Models
model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  avatar            String?
  supabaseId        String   @unique
  email             String   @unique
  bio               String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)
  hasCompletedSetup Boolean  @default(false)

  // New fields
  dateOfBirth  DateTime?
  gender       Gender?
  ridingStyles RidingStyle[] @default([])
  interests    Interest[]    @default([])

  // Notification permission fields
  notificationPermission NotificationPermission @default(UNKNOWN)

  // Relations
  createdGroups        Group[]           @relation("GroupCreatedBy")
  updatedGroups        Group[]           @relation("GroupUpdatedBy")
  groupMemberships     GroupMembership[] @relation("UserGroupMembership")
  createdMemberships   GroupMembership[] @relation("MembershipCreatedBy")
  updatedMemberships   GroupMembership[] @relation("MembershipUpdatedBy")
  notifications        Notification[]
  createdNotifications Notification[]    @relation("NotificationCreatedBy")
  updatedNotifications Notification[]    @relation("NotificationUpdatedBy")
  deviceTokens         DeviceToken[]
  posts                Post[]
  updatedPosts         Post[]            @relation("PostUpdatedBy")
  comments             Comment[]
  updatedComments      Comment[]         @relation("CommentUpdatedBy")
  postLikes            PostLike[]
  postSaves            PostSave[]
  socialMediaProfiles  SocialMedia[]
  updatedSocialMedia   SocialMedia[]     @relation("SocialMediaUpdatedBy")

  // Garage system relations
  garages            Garage[]     @relation("UserGarages")
  updatedGarages     Garage[]     @relation("GarageUpdatedBy")
  createdMotorcycles Motorcycle[] @relation("MotorcycleCreatedBy")
  updatedMotorcycles Motorcycle[] @relation("MotorcycleUpdatedBy")
  createdEquipment   Equipment[]  @relation("EquipmentCreatedBy")
  updatedEquipment   Equipment[]  @relation("EquipmentUpdatedBy")

  // Following system relations
  followers UserFollowing[] @relation("UserFollowers")
  following UserFollowing[] @relation("UserFollowing")

  // Event relations
  createdEvents       Event[]            @relation("EventCreatedBy")
  updatedEvents       Event[]            @relation("EventUpdatedBy")
  eventParticipations EventParticipant[] @relation("EventParticipantCreatedBy")
  receivedInvitations EventInvitation[]  @relation("ReceivedInvitations")

  // Added relations for EventInvitation
  createdEventInvitations EventInvitation[] @relation("EventInvitationCreatedBy")
  updatedEventInvitations EventInvitation[] @relation("EventInvitationUpdatedBy")

  // EventParticipant relations
  updatedEventParticipants EventParticipant[] @relation("EventParticipantUpdatedBy")

  // Notification settings relations
  notificationSettings UserNotificationSetting[]

  @@index([supabaseId])
  @@index([isActive])
  @@index([ridingStyles])
  @@index([gender])
  @@index([interests])
  @@index([cityId])
  @@index([notificationPermission])
}

// User notification settings
model UserNotificationSetting {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType NotificationType
  channel          NotificationChannel
  isEnabled        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, notificationType, channel])
  @@index([userId])
  @@index([notificationType])
  @@index([channel])
  @@index([isEnabled])
}

// New model for user garages
model Garage {
  id          String       @id @default(uuid())
  name        String
  description String?
  equipments  Equipment[]
  motorcycles Motorcycle[] // Add relation to motorcycles

  // Base model fields
  createdById String
  createdBy   User     @relation("UserGarages", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("GarageUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([isActive])
}

// New model for motorcycles
model Motorcycle {
  id          String   @id @default(uuid())
  brand       String
  model       String
  year        Int?
  description String?
  images      String[] @default([])
  garageId    String // Change to reference garage instead of user
  garage      Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  // Base model fields
  createdById String
  createdBy   User     @relation("MotorcycleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("MotorcycleUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([garageId])
  @@index([brand])
  @@index([isActive])
}

// New model for equipment in garages
model Equipment {
  id          String        @id @default(uuid())
  name        String
  type        EquipmentType
  brand       String
  model       String
  year        Int?
  description String?
  images      String[]      @default([])
  garageId    String
  garage      Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)

  // Base model fields
  createdById String
  createdBy   User     @relation("EquipmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EquipmentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([garageId])
  @@index([type])
  @@index([brand])
  @@index([isActive])
}

// New model for social media profiles
model SocialMedia {
  id       String              @id @default(uuid())
  platform SocialMediaPlatform
  username String
  url      String

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("SocialMediaUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([createdById, platform])
  @@index([createdById])
  @@index([platform])
  @@index([isActive])
}

model City {
  id    String @id @default(uuid())
  value String

  // Relations
  groups Group[]
  users  User[]

  @@index([value])
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String
  logo            String?
  cover           String?
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  privacy         GroupPrivacy
  tags            GroupTag[] // Changed from GroupTag[] relation to GroupTag[] enum array
  membersCapacity Int?

  // Base model fields
  createdById String
  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  memberships GroupMembership[]
  posts       Post[]
  events      Event[]

  @@index([cityId])
  @@index([privacy])
}

model GroupMembership {
  id       String           @id @default(uuid())
  groupId  String
  group    Group            @relation(fields: [groupId], references: [id])
  userId   String
  user     User             @relation("UserGroupMembership", fields: [userId], references: [id])
  role     GroupMemberRole
  status   InvitationStatus @default(PENDING)
  joinedAt DateTime         @default(now())

  // Base model fields
  createdById String
  createdBy   User     @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@index([role])
  @@index([isActive])
}

model Notification {
  id      String              @id @default(uuid())
  title   String
  body    String
  type    NotificationType
  channel NotificationChannel
  data    Json?               @default("{}")
  userId  String
  user    User                @relation(fields: [userId], references: [id])
  status  NotificationStatus  @default(PENDING)
  read    Boolean             @default(false)

  // Base model fields
  createdById String
  createdBy   User     @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String
  updatedBy   User     @relation("NotificationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([read])
  @@index([createdAt]) // Added index for filtering by creation date
  @@index([isActive])
}

model DeviceToken {
  id         String   @id @default(uuid())
  token      String
  type       String // 'ios' or 'android'
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([userId])
  @@index([userId])
  @@index([isActive])
  @@index([type])
}

model Post {
  id        String     @id @default(uuid())
  content   String
  images    String[]
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  comments  Comment[]
  likes     PostLike[] // Added relation to PostLike
  saves     PostSave[] // Added relation to PostSave
  addresses Address[] // Added relation to Address

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([groupId])
  @@index([createdAt]) // Added for feed sorting
  @@index([isActive])
}

model Comment {
  id      String @id @default(uuid())
  content String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String

  // Parent-child relationship for comment replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("CommentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([postId])
  @@index([parentId])
  @@index([createdAt]) // Added for sorting
  @@index([isActive])
}

// New model for post likes
model PostLike {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// New model for post saves
model PostSave {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// New model for addresses with support for both posts and events
model Address {
  id        String      @id @default(uuid())
  address   String
  language  Language // Change from String to Language enum
  type      AddressType
  latitude  Float
  longitude Float

  // Relations - one address belongs to either a post or an event
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String?

  @@unique([postId, language, type]) // Ensure unique addresses per post/language/type
  @@unique([eventId, language, type]) // Ensure unique addresses per event/language/type
  @@index([postId])
  @@index([eventId])
  @@index([language])
  @@index([type])
  @@index([latitude, longitude]) // Added for geospatial queries
}

// User following relationships
model UserFollowing {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
}

// Event model
model Event {
  id              String    @id @default(uuid())
  title           String    @db.VarChar(100)
  description     String    @db.Text
  eventType       EventType
  startDateTime   DateTime
  endDateTime     DateTime?
  maxParticipants Int?
  isPrivate       Boolean   @default(false)
  images          String[]

  // Ride-specific fields
  roadType           RoadType?
  difficultyLevel    DifficultyLevel?
  routeDescription   String?          @db.Text
  restStops          String?          @db.Text
  campingInfo        String?          @db.Text
  equipmentChecklist String?          @db.Text

  // Training-specific fields
  instructorInfo  String?          @db.Text
  topicsCovered   String?          @db.Text
  experienceLevel ExperienceLevel?
  price           Float?

  // Base model fields
  createdById String
  createdBy   User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relationships
  participants  EventParticipant[]
  invitations   EventInvitation[]
  addresses     Address[]
  invitedGroups Group[]

  @@index([eventType])
  @@index([startDateTime])
  @@index([createdById])
  @@index([isActive])
  @@index([isPrivate])
}

// Event participant model
model EventParticipant {
  id      String                 @id @default(uuid())
  event   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  status  EventParticipantStatus @default(JOINED)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventParticipantCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventParticipantUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, createdById])
  @@index([eventId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([isActive])
}

// Event invitation model
model EventInvitation {
  id        String           @id @default(uuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User             @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    InvitationStatus @default(PENDING)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventInvitationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventInvitationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, inviteeId])
  @@index([eventId])
  @@index([createdById])
  @@index([inviteeId])
  @@index([status])
  @@index([createdAt])
  @@index([isActive])
}
