  TOURING
  TRACK
  VINTAGE_LOVERS
  WOMEN_RIDERS
  YOUNG_RIDERS
}

enum SupportCategory {
  ACCOUNT
  TECHNICAL
  FEEDBACK
  FEATURE_REQUEST
  BUG_REPORT
  OTHER
}

enum WarningType {
  RADAR
  POLICE_CHECKPOINT
  ACCIDENT
  ROAD_CONSTRUCTION
  ROAD_CLOSURE
  DANGEROUS_CURVE
  SLIPPERY_ROAD
  PARKING_PROHIBITED
  OTHER
}

enum EmergencyType {
  ACCIDENT
  BREAKDOWN
  MEDICAL
  FUEL_SHORTAGE
  TIRE_PROBLEM
  BATTERY_DEAD
  LOST
  OTHER
}

// Models
model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  avatar            String?
  supabaseId        String   @unique
  email             String   @unique
  bio               String?
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)
  hasCompletedSetup Boolean  @default(false)

  // New fields
  dateOfBirth  DateTime?
  gender       Gender?
  ridingStyles RidingStyle[] @default([])
  interests    Interest[]    @default([])

  // Relations
  createdGroups        Group[]           @relation("GroupCreatedBy")
  updatedGroups        Group[]           @relation("GroupUpdatedBy")
  groupMemberships     GroupMembership[] @relation("UserGroupMembership")
  createdMemberships   GroupMembership[] @relation("MembershipCreatedBy")
  updatedMemberships   GroupMembership[] @relation("MembershipUpdatedBy")
  notifications        Notification[]
  createdNotifications Notification[]    @relation("NotificationCreatedBy")
  updatedNotifications Notification[]    @relation("NotificationUpdatedBy")
  deviceTokens         DeviceToken[]
  posts                Post[]
  updatedPosts         Post[]            @relation("PostUpdatedBy")
  postComments         PostComment[]
  updatedPostComments  PostComment[]     @relation("PostCommentUpdatedBy")
  postLikes            PostLike[]
  postSaves            PostSave[]
  socialMediaProfiles  SocialMedia[]
  updatedSocialMedia   SocialMedia[]     @relation("SocialMediaUpdatedBy")

  // Motorcycle and Equipment relations
  motorcycles        Motorcycle[]
  equipments         Equipment[]
  updatedMotorcycles Motorcycle[] @relation("MotorcycleUpdatedBy")
  updatedEquipments  Equipment[]  @relation("EquipmentUpdatedBy")
  userSetting        UserSetting?

  // Following system relations
  followers UserFollowing[] @relation("UserFollowers")

  // Support requests
  supportRequests        SupportRequest[]
  updatedSupportRequests SupportRequest[] @relation("SupportRequestUpdatedBy")
  following              UserFollowing[]  @relation("UserFollowing")

  // Warning relations
  createdWarnings Warning[] @relation("WarningCreatedBy")
  updatedWarnings Warning[] @relation("WarningUpdatedBy")

  // Emergency relations
  createdEmergencies Emergency[] @relation("EmergencyCreatedBy")
  updatedEmergencies Emergency[] @relation("EmergencyUpdatedBy")

  // Event relations
  createdEvents       Event[]            @relation("EventCreatedBy")
  updatedEvents       Event[]            @relation("EventUpdatedBy")
  eventParticipations EventParticipant[] @relation("EventParticipantCreatedBy")
  receivedInvitations EventInvitation[]  @relation("ReceivedInvitations")

  // Added relations for EventInvitation
  createdEventInvitations EventInvitation[] @relation("EventInvitationCreatedBy")
  updatedEventInvitations EventInvitation[] @relation("EventInvitationUpdatedBy")

  // EventParticipant relations
  updatedEventParticipants EventParticipant[] @relation("EventParticipantUpdatedBy")

  // Business comment relations
  businessComments        BusinessComment[]
  updatedBusinessComments BusinessComment[] @relation("BusinessCommentUpdatedBy")

  @@index([supabaseId])
  @@index([cityId])
}

// Model for motorcycles
model Motorcycle {
  id          String   @id @default(uuid())
  brand       String
  model       String
  year        Int?
  description String?
  images      String[] @default([])

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("MotorcycleUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
}

// Model for equipment
model Equipment {
  id          String        @id @default(uuid())
  name        String
  type        EquipmentType
  brand       String
  model       String
  year        Int?
  description String?
  images      String[]      @default([])

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EquipmentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
}

// New model for social media profiles
model SocialMedia {
  id       String              @id @default(uuid())
  platform SocialMediaPlatform
  username String
  url      String

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("SocialMediaUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([createdById, platform])
  @@index([createdById])
}

model City {
  id    String @id @default(uuid())
  value String

  // Relations
  groups Group[]
  users  User[]
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String
  logo            String?
  cover           String?
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  privacy         GroupPrivacy
  tags            GroupTag[] // Changed from GroupTag[] relation to GroupTag[] enum array
  membersCapacity Int?

  // Base model fields
  createdById String
  createdBy   User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  memberships         GroupMembership[]
  posts               Post[]
  events              Event[]
  organizedEvents     Event[]           @relation("EventOrganizedByGroup")
  selectedEmergencies Emergency[]       @relation("EmergencySelectedGroups")

  @@index([cityId])
  @@index([createdById])
}

model GroupMembership {
  id      String          @id @default(uuid())
  groupId String
  group   Group           @relation(fields: [groupId], references: [id])
  userId  String
  user    User            @relation("UserGroupMembership", fields: [userId], references: [id])
  role    GroupMemberRole
  status  ApprovalStatus  @default(PENDING)

  // Base model fields
  createdById String
  createdBy   User     @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([createdById])
}

model Notification {
  id      String              @id @default(uuid())
  title   String
  body    String
  type    NotificationType
  channel NotificationChannel
  data    Json?               @default("{}")
  userId  String
  user    User                @relation(fields: [userId], references: [id])
  status  NotificationStatus  @default(PENDING)
  read    Boolean             @default(false)

  // Base model fields
  createdById String
  createdBy   User     @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("NotificationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([createdById])
}

model DeviceToken {
  id         String   @id @default(uuid())
  token      String
  type       String // 'ios' or 'android'
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([userId])
}

model Post {
  id        String        @id @default(uuid())
  content   String
  images    String[]
  group     Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  comments  PostComment[]
  likes     PostLike[] // Added relation to PostLike
  saves     PostSave[] // Added relation to PostSave
  addresses PostAddress[] // Added relation to PostAddress

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([groupId])
}

model PostComment {
  id      String @id @default(uuid())
  content String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("PostCommentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([postId])
}

// Business comment model for reviews and feedback
model BusinessComment {
  id      String @id @default(uuid())
  content String @db.Text
  rating  Int    @default(5) // 1-5 star rating

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("BusinessCommentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([businessId])
}

// New model for post likes
model PostLike {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// New model for post saves
model PostSave {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// Post address model
model PostAddress {
  id          String   @id @default(uuid())
  address     String
  countryCode String?
  language    Language
  latitude    Float
  longitude   Float

  // Relations
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@unique([postId, language])
  @@index([latitude, longitude])
}

// Event address model
model EventAddress {
  id          String      @id @default(uuid())
  address     String
  countryCode String?
  language    Language
  type        AddressType // Only for events: MEETING, START, FINISH
  latitude    Float
  longitude   Float

  // Relations
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  @@unique([eventId, language, type])
  @@index([latitude, longitude])
}

// Business address model
model BusinessAddress {
  id          String   @id @default(uuid())
  address     String
  countryCode String?
  language    Language
  latitude    Float
  longitude   Float

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  @@unique([businessId, language])
  @@index([latitude, longitude])
  @@index([businessId, latitude, longitude])
}

// Business model
model Business {
  id          String           @id @default(uuid())
  name        String
  category    BusinessCategory
  countryCode String?
  phoneNumber String
  verified    Boolean          @default(false)
  status      ApprovalStatus   @default(PENDING)

  // Relations
  addresses    BusinessAddress[]
  descriptions BusinessDescription[]
  workingHours WorkingHour[]
  comments     BusinessComment[]

  // Base model fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

// Business description model for multi-language support
model BusinessDescription {
  id          String   @id @default(uuid())
  description String   @db.Text
  language    Language

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  // Base model fields
  isActive Boolean @default(true)

  @@unique([businessId, language]) // Ensure unique description per business/language
}

// Working hours model for businesses
model WorkingHour {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek
  startHour String? // Format: "09:00" or null if closed
  endHour   String? // Format: "18:00" or null if closed
  isOpen24h Boolean   @default(false)

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  // Base model fields
  isActive Boolean @default(true)

  @@unique([businessId, dayOfWeek])
}

// User following relationships
model UserFollowing {
  id          String         @id @default(uuid())
  followerId  String
  follower    User           @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User           @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  status      ApprovalStatus @default(PENDING)
  isActive    Boolean        @default(true)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Event model
model Event {
  id              String      @id @default(uuid())
  title           String      @db.VarChar(100)
  description     String      @db.Text
  eventType       EventType
  status          EventStatus @default(DRAFT)
  startDateTime   DateTime
  endDateTime     DateTime?
  maxParticipants Int?
  isPrivate       Boolean     @default(false)
  images          String[]

  // Organized by field - can be group
  organizedByGroupId String?
  organizedByGroup   Group?  @relation("EventOrganizedByGroup", fields: [organizedByGroupId], references: [id])

  // Ride-specific fields
  roadType           RoadType?
  difficultyLevel    DifficultyLevel?
  routeDescription   String?          @db.Text
  restStops          String?          @db.Text
  campingInfo        String?          @db.Text
  equipmentChecklist String?          @db.Text

  // Training-specific fields
  instructorInfo  String?          @db.Text
  topicsCovered   String?          @db.Text
  experienceLevel ExperienceLevel?
  price           Float?
  currency        Currency?        @default(TL)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relationships
  participants  EventParticipant[]
  invitations   EventInvitation[]
  addresses     EventAddress[]
  invitedGroups Group[]

  @@index([createdById])
  @@index([organizedByGroupId])
}

// Event participant model
model EventParticipant {
  id      String                 @id @default(uuid())
  event   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  status  EventParticipantStatus @default(JOINED)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventParticipantCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventParticipantUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, createdById])
  @@index([createdById])
}

// Event invitation model
model EventInvitation {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User           @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    ApprovalStatus @default(PENDING)

  // Base model fields
  createdById String
  createdBy   User     @relation("EventInvitationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EventInvitationUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@unique([eventId, inviteeId])
  @@index([createdById])
  @@index([inviteeId])
}

// User settings model
model UserSetting {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Privacy settings
  autoAcceptFollowers Boolean @default(false)

  // Language preference for notifications and app content
  preferredLanguage Language @default(TR)

  // Notification permission fields
  notificationPermission NotificationPermission @default(UNKNOWN)

  // Notification preferences
  notificationPreferences Json? // Map of NotificationType to boolean

  // Base model fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportRequest {
  id         String          @id @default(uuid())
  category   SupportCategory
  subject    String
  message    String
  deviceInfo Json?

  // Base model fields
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation(name: "SupportRequestUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
}

// Warning model
model Warning {
  id     String         @id @default(uuid())
  type   WarningType
  status ApprovalStatus @default(PENDING)

  // Relations
  descriptions WarningDescription[]
  addresses    WarningAddress[]

  // Base model fields
  createdById String
  createdBy   User     @relation("WarningCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("WarningUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([type])
}

// Warning description model for multi-language support
model WarningDescription {
  id          String   @id @default(uuid())
  description String   @db.Text
  language    Language @default(TR)

  // Relations
  warning   Warning @relation(fields: [warningId], references: [id], onDelete: Cascade)
  warningId String

  // Base model fields
  isActive Boolean @default(true)

  @@unique([warningId, language]) // Ensure unique description per warning/language
  @@index([warningId])
}

// Warning address model for location information
model WarningAddress {
  id          String   @id @default(uuid())
  address     String
  countryCode String?
  language    Language
  latitude    Float
  longitude   Float

  // Relations
  warning   Warning @relation(fields: [warningId], references: [id], onDelete: Cascade)
  warningId String

  @@unique([warningId, language]) // Ensure unique address per warning/language
  @@index([warningId])
  @@index([latitude, longitude]) // For location-based queries
}

// Emergency model
model Emergency {
  id     String         @id @default(uuid())
  type   EmergencyType
  status ApprovalStatus @default(ACCEPTED)

  // Relations
  descriptions   EmergencyDescription[]
  addresses      EmergencyAddress[]
  selectedGroups Group[]                @relation("EmergencySelectedGroups")

  // Base model fields
  createdById String
  createdBy   User     @relation("EmergencyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("EmergencyUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  @@index([createdById])
  @@index([type])
}

// Emergency description model for multi-language support
model EmergencyDescription {
  id          String   @id @default(uuid())
  description String   @db.Text
  language    Language @default(TR)

  // Relations
  emergency   Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  emergencyId String

  // Base model fields
  isActive Boolean @default(true)

  @@unique([emergencyId, language]) // Ensure unique description per emergency/language
  @@index([emergencyId])
}

// Emergency address model for location information
model EmergencyAddress {
  id          String   @id @default(uuid())
  address     String
  countryCode String?
  language    Language
  latitude    Float
  longitude   Float

  // Relations
  emergency   Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  emergencyId String

  @@unique([emergencyId, language]) // Ensure unique address per emergency/language
  @@index([emergencyId])
  @@index([latitude, longitude]) // For location-based queries
}
