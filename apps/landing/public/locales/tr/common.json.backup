    "terms": {
      "title": "Kullanım Koşulları",
      "lastUpdated": "Son Güncelleme: 1 Eylül, 2023",
      "sections": {
        "introduction": {
          "title": "Giriş",
          "content": "Motorove'ye hoş geldiniz. Web sitemize erişerek ve hizmetlerimizi kullanarak, bu Kullanım Koşulları'na bağlı kalmayı kabul edersiniz. Lütfen platformumuzu kullanmadan önce bunları dikkatlice okuyun."
        },
        "definitions": {
          "title": "Tanımlar",
          "content": "'Hizmet', Motorove web sitesini ve mobil uygulamasını ifade eder. 'Kullanıcı', Hizmete erişen veya kullanan herhangi bir bireyi ifade eder. 'İçerik', Hizmete yüklenen, indirilen veya Hizmet'te görünen tüm bilgi, metin, grafik, fotoğraf, video veya diğer materyalleri ifade eder."
        },
        "accountRegistration": {
          "title": "Hesap Kaydı",
          "content": "Hizmetin belirli özelliklerini kullanmak için bir hesap kaydı yapmanız gerekir. Doğru ve eksiksiz bilgi sağlamalı ve hesap bilgilerinizi güncel tutmalısınız. Hesabınızı ve şifrenizi korumaktan siz sorumlusunuz. Hesabınız altında gerçekleşen herhangi bir etkinlikten siz sorumlusunuz."
        },
        "userContent": {
          "title": "Kullanıcı İçeriği",
          "content": "Hizmete gönderdiğiniz herhangi bir içeriğin mülkiyet haklarını siz elinde tutarsınız. İçerik göndererek, Motorove'ye böyle bir içeriği kullanmak, kopyalamak, çoğaltmak, işlemek, uyarlamak, değiştirmek, yayınlamak, iletmek, görüntülemek ve dağıtmak için dünya çapında, münhasır olmayan, telifsiz bir lisans verirsiniz."
        },
        "prohibitedActivities": {
          "title": "Yasaklanmış Faaliyetler",
          "content": "Aşağıdaki yasaklanmış faaliyetlerden herhangi birine girişmemeyi kabul edersiniz:",
          "items": {
            "item1": "Herhangi bir yasa, kural veya yönetmeliği ihlal etmek.",
            "item2": "Karalama, müstehcen veya başka türlü itiraz edilebilir içerik göndermek.",
            "item3": "Herhangi bir kişiyi veya kuruluşu taklit etmek veya bir kişi veya kuruluşla bağlantınızı yanlış beyan etmek.",
            "item4": "Hizmeti veya Hizmete bağlı sunucuları veya ağları engellemek veya bozmak.",
            "item5": "Hizmete veya kullanıcı hesaplarına yetkisiz erişim sağlamaya çalışmak."
          }
        },
        "intellectualProperty": {
          "title": "Fikri Mülkiyet",
          "content": "Hizmet ve orijinal içeriği, özellikleri ve işlevselliği Motorove'ye aittir ve uluslararası telif hakkı, ticari marka, patent, ticari sır ve diğer fikri mülkiyet veya mülkiyet hakları yasalarıyla korunmaktadır."
        },
        "termination": {
          "title": "Fesih",
          "content": "Hesabınızı herhangi bir nedenle, Kullanım Koşulları'nı ihlal etmeniz de dahil olmak üzere, önceden bildirimde bulunmaksızın veya sorumluluk olmaksızın derhal feshedebilir veya askıya alabiliriz."
        },
        "disclaimer": {
          "title": "Sorumluluk Reddi",
          "content": "Hizmet 'OLDUĞU GİBİ' ve 'MEVCUT OLDUĞU GİBİ' sunulur. Hizmet, satılabilirlik, belirli bir amaca uygunluk, ihlal etmeme veya performans seyri dahil ancak bunlarla sınırlı olmamak üzere, açık veya zımni herhangi bir garanti olmaksızın sunulmaktadır."
        },
        "limitation": {
          "title": "Sorumluluk Sınırlaması",
          "content": "Hiçbir durumda Motorove, kar kaybı, veri kaybı, kullanım kaybı, şöhret kaybı veya diğer maddi olmayan kayıplar dahil ancak bunlarla sınırlı olmamak üzere, Hizmete erişiminiz veya kullanımınızdan kaynaklanan veya erişememenizden kaynaklanan dolaylı, tesadüfi, özel, dolaylı veya cezai zararlardan sorumlu tutulmayacaktır."
        },
        "governing": {
          "title": "Geçerli Yasa",
          "content": "Bu Koşullar, Türkiye yasalarına göre yönetilecek ve yorumlanacaktır, yasa hükümlerinin çatışmasına bakılmaksızın."
        },
        "changes": {
          "title": "Koşullardaki Değişiklikler",
          "content": "Bu Koşulları herhangi bir zamanda, kendi takdirimize bağlı olarak değiştirme veya değiştirme hakkını saklı tutarız. Önemli bir değişikliğin ne olduğuna, kendi takdirimize bağlı olarak karar verilecektir. Bu değişiklikler geçerli olduktan sonra Hizmetimize erişmeye veya kullanmaya devam ederek, revize edilmiş koşullara bağlı kalmayı kabul edersiniz."
        },
        "contact": {
          "title": "Bize Ulaşın",
          "content": "Bu Koşullar hakkında herhangi bir sorunuz varsa, lütfen terms@motorove.app adresinden bizimle iletişime geçin."
        }
      }
    },
    "privacy": {
      "title": "Gizlilik Politikası",
