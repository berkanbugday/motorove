{
	"name": "motorove",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"clean": "turbo clean && rm -rf node_modules",
		"test": "turbo test",
		"format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
		"types": "turbo types",
		"start": "turbo start",
		"prepare": "husky install",
		"ios": "pnpm --filter @motorove/mobile ios",
		"android": "pnpm --filter @motorove/mobile android",
		"pod-install": "pnpm --filter @motorove/mobile pod-install",
		"mobile:dev": "pnpm --filter @motorove/mobile dev",
		"api:dev": "pnpm --filter @motorove/api dev",
		"api:db:generate": "pnpm --filter @motorove/api db:generate",
		"api:db:migrate": "pnpm --filter @motorove/api db:migrate"
	},
	"devDependencies": {
		"turbo": "2.4.4",
		"prettier": "^3.2.5",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.2",
		"@commitlint/cli": "^19.0.3",
		"@commitlint/config-conventional": "^19.0.3"
	},
	"packageManager": "pnpm@10.6.1",
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=10.0.0"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
