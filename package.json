{
  "name": "motorove",
  "version": "1.0.0",
  "description": "Motorove monorepo containing backend, mobile, and shared packages",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/mobile",
    "shared"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "build:shared": "pnpm --filter=@motorove/shared build",
    "build:backend": "pnpm --filter=@motorove/backend build",
    "build:mobile": "pnpm --filter=@motorove/mobile build",
    "dev:backend": "pnpm --filter=@motorove/backend dev",
    "dev:mobile": "pnpm --filter=@motorove/mobile dev",
    "format": "turbo format",
    "clean:deps": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "reset": "pnpm clean:deps && pnpm install",
    "check:deps": "pnpm dlx depcheck",
    "check:outdated": "pnpm -r exec pnpm outdated",
    "update:deps": "pnpm -r update",
    "postinstall": "patch-package",
    "shared:build": "pnpm --filter=@motorove/shared build",
    "shared:dev": "pnpm --filter=@motorove/shared dev",
    "shared:lint": "pnpm --filter=@motorove/shared lint",
    "shared:test": "pnpm --filter=@motorove/shared test",
    "shared:clean": "pnpm --filter=@motorove/shared clean",
    "backend:build": "pnpm --filter=@motorove/backend build",
    "backend:dev": "pnpm --filter=@motorove/backend dev",
    "backend:start": "pnpm --filter=@motorove/backend start",
    "backend:start:dev": "pnpm --filter=@motorove/backend start:dev",
    "backend:start:staging": "pnpm --filter=@motorove/backend start:staging",
    "backend:start:prod": "pnpm --filter=@motorove/backend start:prod",
    "backend:lint": "pnpm --filter=@motorove/backend lint",
    "backend:test": "pnpm --filter=@motorove/backend test",
    "backend:test:watch": "pnpm --filter=@motorove/backend test:watch",
    "backend:test:cov": "pnpm --filter=@motorove/backend test:cov",
    "backend:test:debug": "pnpm --filter=@motorove/backend test:debug",
    "backend:test:e2e": "pnpm --filter=@motorove/backend test:e2e",
    "backend:clean": "pnpm --filter=@motorove/backend clean",
    "backend:prisma:generate": "pnpm --filter=@motorove/backend prisma:generate",
    "backend:prisma:migrate:dev": "pnpm --filter=@motorove/backend prisma:migrate:dev",
    "backend:prisma:migrate:reset:dev": "pnpm --filter=@motorove/backend prisma:migrate:reset:dev",
    "backend:prisma:migrate:deploy": "pnpm --filter=@motorove/backend prisma:migrate:deploy",
    "backend:prisma:studio": "pnpm --filter=@motorove/backend prisma:studio",
    "backend:prisma:seed": "pnpm --filter=@motorove/backend prisma:seed",
    "mobile:start": "pnpm --filter=@motorove/mobile dev",
    "mobile:start:clean": "pnpm --filter=@motorove/mobile start:clean",
    "mobile:clear-cache": "pnpm --filter=@motorove/mobile clear-cache",
    "mobile:android:dev": "pnpm --filter=@motorove/mobile android:dev",
    "mobile:android:staging": "pnpm --filter=@motorove/mobile android:staging",
    "mobile:android:prod": "pnpm --filter=@motorove/mobile android:prod",
    "mobile:android:release:dev": "pnpm --filter=@motorove/mobile android:release:dev",
    "mobile:android:release:staging": "pnpm --filter=@motorove/mobile android:release:staging",
    "mobile:android:release:prod": "pnpm --filter=@motorove/mobile android:release:prod",
    "mobile:build:android:dev": "pnpm --filter=@motorove/mobile build:android:dev",
    "mobile:build:android:staging": "pnpm --filter=@motorove/mobile build:android:staging",
    "mobile:build:android:prod": "pnpm --filter=@motorove/mobile build:android:prod",
    "mobile:ios:dev": "pnpm --filter=@motorove/mobile ios:dev",
    "mobile:ios:staging": "pnpm --filter=@motorove/mobile ios:staging",
    "mobile:ios:prod": "pnpm --filter=@motorove/mobile ios:prod",
    "mobile:build:ios:dev": "pnpm --filter=@motorove/mobile build:ios:dev",
    "mobile:build:ios:staging": "pnpm --filter=@motorove/mobile build:ios:staging",
    "mobile:build:ios:prod": "pnpm --filter=@motorove/mobile build:ios:prod",
    "mobile:run-both": "pnpm --filter=@motorove/mobile run-both",
    "mobile:lint": "pnpm --filter=@motorove/mobile lint",
    "mobile:test": "pnpm --filter=@motorove/mobile test"
  },
  "devDependencies": {
    "turbo": "1.12.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.6.0"
  },
  "packageManager": "pnpm@9.6.0",
  "dependencies": {
    "patch-package": "8.0.0",
    "postinstall-postinstall": "2.1.0"
  }
}