{
	"name": "motorove",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"clean": "turbo clean && rm -rf node_modules",
		"test": "turbo test",
		"format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
		"types": "turbo types",
		"start": "turbo start",
		"postinstall": "husky",
		"build:ios": "pnpm --filter @motorove/mobile build:ios",
		"build:android": "pnpm --filter @motorove/mobile build:android",
		"ios": "pnpm --filter @motorove/mobile ios",
		"android": "pnpm --filter @motorove/mobile android",
		"pod-install": "pnpm --filter @motorove/mobile pod-install",
		"mobile:dev": "pnpm --filter @motorove/mobile dev",
		"api:dev": "pnpm --filter @motorove/api dev",
		"api:db:generate": "pnpm --filter @motorove/api db:generate",
		"api:db:migrate": "pnpm --filter @motorove/api db:migrate",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.0",
		"prettier": "^3.5.3",
		"turbo": "2.5.0"
	},
	"packageManager": "pnpm@10.6.1",
	"engines": {
		"node": ">=20",
		"pnpm": ">=10"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
